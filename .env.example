DJANGO_SECRET_KEY=replace-with-a-random-secret
DOMAIN=localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_DB=finance_ocr
# Four runtime roles, plus the bootstrap owner. The owner is then unused; the
# app can only read and write rows; migrations own the schema; backup and the
# readonly role can read without writing.
POSTGRES_OWNER_USER=finance_owner
POSTGRES_OWNER_PASSWORD=replace-with-an-owner-password
POSTGRES_APP_USER=finance_app
POSTGRES_APP_PASSWORD=replace-with-an-application-password
POSTGRES_MIGRATION_USER=finance_migrate
POSTGRES_MIGRATION_PASSWORD=replace-with-a-migration-password
POSTGRES_BACKUP_USER=finance_backup
POSTGRES_BACKUP_PASSWORD=replace-with-a-backup-password
POSTGRES_READONLY_USER=finance_readonly
POSTGRES_READONLY_PASSWORD=replace-with-a-readonly-password
# What Django itself reads. Under Compose these are set from POSTGRES_APP_* for
# the web and worker containers; set them directly when running outside Compose.
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=replace-with-an-application-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60
FIELD_ENCRYPTION_MASTER_KEY_SOURCE=./secrets/field-encryption-master-key
# Disabled by default. When true, duplicate candidates scoring at least 90 are
# merged automatically and the score and matched features are audited.
AUTOMATIC_RECONCILIATION_MERGE_ENABLED=false
# Worker liveness is database-backed; no worker network port is required.
WORKER_HEARTBEAT_STALE_SECONDS=180
PROCESSING_STUCK_AFTER_SECONDS=900
# Optional. Keep disabled unless the deployment has approved the scrubbed event
# payload and its retention policy.
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
