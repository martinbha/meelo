DJANGO_SECRET_KEY=replace-with-a-random-secret
DOMAIN=localhost
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_TIME_ZONE=Asia/Seoul
DJANGO_SECURE_SSL_REDIRECT=true
DJANGO_HSTS_SECONDS=31536000
DJANGO_CSRF_TRUSTED_ORIGINS=https://localhost
DATABASE_ENGINE=django.db.backends.postgresql
POSTGRES_DB=finance_ocr
POSTGRES_USER=finance_app
POSTGRES_PASSWORD=replace-with-a-database-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_CONN_MAX_AGE=60
FIELD_ENCRYPTION_MASTER_KEY_SOURCE=./secrets/field-encryption-master-key
